# ShieldHer Backend Environment Variables

# PostgreSQL connection string
# For local: postgresql://postgres:password@localhost:5432/shieldher
# For Supabase/Neon free tier: get the connection string from their dashboard
DATABASE_URL=postgresql://postgres:password@localhost:5432/shieldher

# JWT Secret Key (change this to something random!)
JWT_SECRET_KEY=shieldher-hackathon-secret-change-me-2026

# Google Gemini API Key (get free at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
